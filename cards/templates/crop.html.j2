{% from "macros.j2" import icon %}<!doctype html>
<html lang="ko"><head><meta charset="utf-8"><style>{{ css }}
.page { width: 1080px; height: 1350px; padding: 52px 44px 0; display: flex; flex-direction: column; overflow: hidden; }
.hd2 { position: relative; display: flex; align-items: baseline; gap: 16px; padding-right: 110px; }
.hd2 .store { font-size: 36px; font-weight: 800; letter-spacing: -0.02em; }
.hd2 .when { font-size: 28px; font-weight: 600; color: var(--ink2); }
.pg { position: absolute; top: 0; right: 0; font-size: 28px; font-weight: 700; color: var(--ink3); }
.ctitle { margin-top: 26px; font-size: 46px; font-weight: 800; letter-spacing: -0.02em; }
.cnote { margin-top: 8px; font-size: 28px; color: var(--ink2); }
.hits { margin-top: 18px; border-top: 3px solid var(--ink); }
.hit { display: grid; grid-template-columns: 1fr auto; gap: 18px; align-items: center; padding: 14px 0 15px; border-bottom: 1px solid var(--line); }
.hit .nm { display: flex; align-items: center; gap: 10px; font-size: 34px; font-weight: 800; letter-spacing: -0.015em; }
.hit .nm .icon { width: 28px; height: 28px; }
.hit .p { font-size: 38px; font-weight: 850; color: var(--red); white-space: nowrap; letter-spacing: -0.02em; }
.hit .p small { font-size: 26px; font-weight: 700; color: var(--ink2); letter-spacing: 0; margin-right: 8px; }
.flyer { margin: auto -44px 0; padding-top: 22px; }
.flyer img { display: block; width: 1080px; }
</style></head>
<body><main class="page">
  <header class="hd2">
    <span class="store">{{ store }}</span><span class="when">{{ period }}</span>
    <span class="pg">{{ no }}/{{ total }}</span>
  </header>
  <h2 class="ctitle">전단 원본, {{ where }}</h2>
  <p class="cnote">이 부분에서 기준을 통과한 품목입니다.</p>
  <div class="hits">
    {% for i in items %}
    <div class="hit">
      <p class="nm">{{ icon(i.v.level, 28) }}{{ i.label_name }}</p>
      {% if i.price_num %}
      <p class="p">{% if i.per100 %}<small>100g</small>{% elif i.qty %}<small>{{ i.qty }}</small>{% endif %}{{ i.price_num }}원</p>
      {% else %}
      <p class="p">{{ i.alt_big }}</p>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  <figure class="flyer"><img src="{{ image }}" alt=""></figure>
</main></body></html>
